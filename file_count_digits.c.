#include <stdio.h>
#include <ctype.h>

int main() {
    FILE *file;
    char ch;
    int count = 0;

    file = fopen("data.txt", "r");

    if (file == NULL) {
        printf("File not found.");
        return 1;
    }

    while ((ch = fgetc(file)) != EOF) {
        if (isdigit(ch)) {
            count++;
        }
    }

    printf("Number of digits = %d", count);

    fclose(file);

    return 0;
}
